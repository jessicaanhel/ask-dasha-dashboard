[Unit]
Description=Ask Dasha backend (mortgage calculator + Dasha chat)
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/ask-dasha/backend
EnvironmentFile=/etc/ask-dasha.env
ExecStart=/home/ubuntu/ask-dasha/backend/.venv/bin/gunicorn -w 1 --threads 4 -b 127.0.0.1:5001 app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
